# macOS
.DS_Store

# LaTeX build files (the .bbl file is kept for arXiv)
*.aux
*.log
*.out
*.blg
*.synctex.gz
*.fls
*.fdb_latexmk
*.toc

# Python
__pycache__/
*.pyc

# Lean build cache, rebuilt by `lake build`
lean/.lake/

# Scratch work
tmp/

# Downloaded datasets (see data/README.md): the subfolders of data/ are
# ignored; only files directly in data/ with these extensions are committed
data/*
!data/*.md
!data/*.py
!data/*.sh
!data/*.csv
